# Copy to `.env` and fill in. `.env` is gitignored.

# Required by chat.py (the CLI chatbot). Free, no credit card.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Without it, charging lookups fall back to the bundled seed dataset
# and say so. Free key: https://openchargemap.org -> profile -> "my apps"
# -> "Register An Application".
OCM_API_KEY=

# Only needed for chat_anthropic.py, the paid Claude variant. Leave blank
# unless you are using that one. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
